generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuoteRequest {
  id          String   @id @default(uuid())
  helpType    String?
  urgency     String?
  subject     String?
  name        String?
  email       String?
  phoneNumber String?
  message     String?
  createdAt   DateTime @default(now())
}
